generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  email     String?
  city      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  Project[]
}

model Project {
  id             String        @id @default(cuid())
  code           String        @unique
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  title          String
  description    String?
  type           ProjectType
  status         ProjectStatus @default(TODO)
  receivedAt     DateTime      @default(now())
  dueDate        DateTime?
  price          Decimal?      @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  payments       Payment[]
  images         ProjectImage[]
  materials      ProjectMaterial[]

  @@index([status])
  @@index([dueDate])
  @@index([clientId])
  @@index([type])
}

model Payment {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id])
  status    PaymentStatus @default(UNPAID)
  method    PaymentMethod?
  paidAt    DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([projectId])
  @@index([status, paidAt])
}

model ProjectImage {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id])
  path      String
  type      ImageType
  createdAt DateTime    @default(now())

  @@index([projectId])
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              UserRole           @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  notificheDismesse NotificaDismissa[]
}

model NotificaDismissa {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  notificaId String
  createdAt  DateTime @default(now())

  @@unique([userId, notificaId])
}

model Material {
  id        String            @id @default(cuid())
  name      String
  category  MaterialCategory
  unit      MaterialUnit
  quantity  Decimal           @db.Decimal(10, 2) @default(0)
  minStock  Decimal           @db.Decimal(10, 2) @default(0)
  unitCost  Decimal?          @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  usages    ProjectMaterial[]

  @@index([category])
}

model ProjectMaterial {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity   Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([materialId])
}

model LabSettings {
  id             String   @id @default(cuid())
  shopName       String
  phone          String?
  address        String?
  currency       String   @default("EUR")
  defaultVatRate Decimal  @db.Decimal(5, 2) @default(22)
  leadTimeDays   Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum ProjectStatus {
  TODO
  IN_PROGRESS
  WAITING_CUSTOMER
  COMPLETED
  CANCELLED
}

enum ProjectType {
  HEM
  WAIST_TIGHTENING
  LEG_SHORTENING
  LEG_WIDENING
  ZIP_REPLACEMENT
  REPAIR
  CUSTOM
  OTHER
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum ImageType {
  BEFORE
  AFTER
  DETAIL
}

enum UserRole {
  ADMIN
  USER
}

enum MaterialCategory {
  FABRIC
  ZIP
  THREAD
  ACCESSORY
  OTHER
}

enum MaterialUnit {
  METER
  PIECE
  SPOOL
  ROLL
  GRAM
}
