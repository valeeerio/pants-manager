# Database — Supabase PostgreSQL
# CONNECTION POOLING (usata da Prisma in produzione su Vercel)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT CONNECTION (usata da Prisma migrate e seed)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.com:5432/postgres"

# Auth.js v5
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"

# Supabase Storage (upload foto Prima/Dopo lavori — lib/supabase-storage.ts)
NEXT_PUBLIC_DATABASE_SUPABASE_URL="https://[project-ref].supabase.co"
DATABASE_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
